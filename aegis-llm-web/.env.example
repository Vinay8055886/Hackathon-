# Aegis-LLM web — environment variables
# Copy to .env.local and adjust.

# ── Backend connection ──────────────────────────────────────────────────────
# Point at the FastAPI backend (uvicorn app.main:app on :8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock mode: serve everything from an in-memory dataset + simulated SSE.
# Great for local dev/preview without a running backend.
NEXT_PUBLIC_API_MOCK=false
# Role used by the mock sign-in (viewer | operator | admin).
NEXT_PUBLIC_MOCK_ROLE=admin

# ── NextAuth (required for sessions) ────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-real-secret-with-openssl-rand-base64-32

# ── Enterprise SSO (optional) ───────────────────────────────────────────────
# When set, the login page also offers "Continue with company SSO".
# The backend's /auth/oidc/login + /auth/oidc/callback implement the flow.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
