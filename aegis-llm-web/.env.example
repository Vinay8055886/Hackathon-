[TEMPLATE]
# Aegis-LLM web — environment variables
# Copy to .env.local and adjust.

# ── Backend connection ──────────────────────────────────────────────────────
# Point at the FastAPI backend (uvicorn app.main:app on :8000).
# For Vercel deployment, set this to your deployed backend URL.
# Example: https://aegis-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock mode: serve everything from an in-memory dataset + simulated SSE.
# Great for local dev/preview without a running backend.
# IMPORTANT: Must be false for the dashboard to show REAL scan data.
NEXT_PUBLIC_API_MOCK=false
# Role used by the mock sign-in (viewer | operator | admin).
NEXT_PUBLIC_MOCK_ROLE=admin

# ── NextAuth (required for sessions) ────────────────────────────────────────
# For Vercel deployment, set NEXTAUTH_URL to your Vercel domain:
#   NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
# IMPORTANT: Generate a real secret before deploying to production.
# Run: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-real-secret-with-openssl-rand-base64-32

# ── Enterprise SSO (optional) ───────────────────────────────────────────────
# When set, the login page also offers "Continue with company SSO".
# The backend's /auth/oidc/login + /auth/oidc/callback implement the flow.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Vercel Deployment Checklist ─────────────────────────────────────────────
# 1. Deploy the FastAPI backend to a persistent host (Railway, Render, Fly.io).
#    The backend CANNOT run on Vercel (it uses SQLite, ARQ workers, Redis,
#    long-running SSE streams, and background scanner processes).
# 2. Set AEGIS_CORS_ALLOWED_ORIGINS on the backend to include your Vercel URL.
#    Example: AEGIS_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# 3. Set NEXT_PUBLIC_API_URL to your backend URL.
# 4. Set NEXTAUTH_URL to your Vercel URL.
# 5. Set NEXTAUTH_SECRET to a real secret (not the placeholder).
# 6. Deploy to Vercel via the dashboard or CLI.
