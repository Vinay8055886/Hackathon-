[TEMPLATE]
# ─── Aegis-LLM configuration ────────────────────────────────────────────────
# Copy to .env and adjust. All values are validated by app/core/config.py.

# Runtime
AEGIS_ENV=dev                       # dev | prod
AEGIS_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./aegis.db   # or postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
AEGIS_REDIS_URL=redis://localhost:6379/0
AEGIS_RUNNER=inproc                 # inproc (demo/tests) | arq (production, requires worker)
AEGIS_DRY_RUN_DEFAULT=true          # runs default to dry-run unless explicitly overridden

# Auth / SSO
AEGIS_JWT_SECRET=change-me-in-production
AEGIS_JWT_ALG=HS256
AEGIS_JWT_EXPIRES_MINUTES=480
AEGIS_ADMIN_USERNAME=admin
AEGIS_ADMIN_PASSWORD=admin          # change immediately in production
# OIDC (optional; requires the `enterprise` extra)
AEGIS_OIDC_ISSUER=
AEGIS_OIDC_CLIENT_ID=
AEGIS_OIDC_CLIENT_SECRET=
AEGIS_OIDC_SCOPES=openid profile email

# Safety limits (enforced at the interaction-layer boundary)
AEGIS_DEFAULT_MAX_TOKENS_PER_RUN=200000
AEGIS_DEFAULT_MAX_TURNS=10
AEGIS_RATE_LIMIT_PER_MINUTE=60      # per target
AEGIS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AEGIS_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
AEGIS_MAX_CONCURRENT_RUNS=4

# LLM-as-judge (optional — heuristic judge used when unset)
AEGIS_JUDGE_API_BASE=https://api.openai.com/v1
AEGIS_JUDGE_API_KEY=
AEGIS_JUDGE_MODEL=gpt-4o-mini

# Embeddings (optional — deterministic hash-based embeddings used when unset)
AEGIS_EMBEDDING_API_BASE=
AEGIS_EMBEDDING_API_KEY=
AEGIS_EMBEDDING_MODEL=text-embedding-3-small
AEGIS_VECTOR_STORE=numpy            # numpy | pgvector (Postgres only)

# Reporting / CI
AEGIS_REPORT_DIR=./reports
AEGIS_CI_DEFAULT_SEVERVERITY_THRESHOLD=high

# Mock target (demo)
AEGIS_MOCK_TARGET_PORT=8100

# Real target defaults (used when registering real AI/LLM targets)
AEGIS_REAL_TARGET_TYPE=auto          # auto | openai-compatible | rest-api | browser | websocket
AEGIS_REAL_TARGET_TIMEOUT=30         # connection timeout in seconds
AEGIS_REAL_TARGET_MAX_REQUESTS=50    # maximum requests per scan
AEGIS_REAL_TARGET_VERIFY_TLS=true    # verify TLS certificates (set false for local dev only)

# Observability
AEGIS_ENABLE_OTEL=false             # requires the `enterprise` extra
AEGIS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
